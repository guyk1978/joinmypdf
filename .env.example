# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://joinmypdf.com

# PostHog (optional — analytics + funnels)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics — cookie banner + GA4 (loads only after consent)
# Production: managed in wrangler.jsonc → vars.NEXT_PUBLIC_GA_MEASUREMENT_ID
# Local dev: copy to .env.local (see .env.example)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form — emails go to CONTACT_EMAIL_TO (default: dgartists@gmail.com)
# Browser delivery uses FormSubmit; optional Resend via /api/contact when RESEND_API_KEY is set.
NEXT_PUBLIC_CONTACT_EMAIL_TO=dgartists@gmail.com
CONTACT_EMAIL_TO=dgartists@gmail.com
RESEND_API_KEY=
CONTACT_EMAIL_FROM=JoinMyPDF <onboarding@resend.dev>

# Private site inventory (admin only) — set to true locally to enable /admin/inventory and header link
NEXT_PUBLIC_ADMIN_INVENTORY=false

# User feedback — EmailJS (client-side; create template with variables below)
# Production: managed in wrangler.jsonc → vars.NEXT_PUBLIC_EMAILJS_*
# Local dev: copy to .env.local (see .env.example)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_joinmypdf
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_azdpj8t
# Cloud file pickers (optional — enables From Dropbox / Google Drive / OneDrive)
# Without these, the UI offers “open provider → download → choose from device”.
# Production builds: also set these in `.env.production` and/or Cloudflare Pages
# build env (NEXT_PUBLIC_* are inlined at `next build`, not at runtime).
# Google OAuth client → Authorized JavaScript origins must include:
#   https://joinmypdf.com  and  https://www.joinmypdf.com  (and local http://localhost:PORT)
NEXT_PUBLIC_DROPBOX_APP_KEY=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional Cloud project number (required for drive.file + Picker). Defaults to the numeric prefix of CLIENT_ID.
NEXT_PUBLIC_GOOGLE_APP_ID=
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=

